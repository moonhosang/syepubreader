{
  "manifest_version": 3,
  "name": "syepubreader",
  "version": "__VERSION__",
  "description": "Open EPUB links in syepubreader — read EPUB like a real book in your browser. Files never leave your device.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open syepubreader",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["contextMenus", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["__APP_MATCH__"], "js": ["content.js"], "run_at": "document_idle" }]
}
