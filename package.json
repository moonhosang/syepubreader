{
  "name": "syepubreader",
  "version": "0.1.0",
  "description": "EPUB/HTML/ZIP 을 책처럼 읽는 웹 리더 — 크롬 번역 결과 내보내기",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "e2e": "playwright test",
    "epub-to-html": "tsx cli/epub-to-html.ts",
    "ext:build": "node scripts/build-extension.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": "true"
}
